[req]
default_bits       	= 2048
prompt             	= no
default_md         	= sha256
distinguished_name 	= req_distinguished_name
req_extensions 		= v3_req
[req_distinguished_name]
C 	= VN
ST 	= HCM
L 	= HCM
O 	= NexOps
OU 	= NexOps
CN 	= *.nebula.sit
[ v3_req ]
# Extensions to add to a certificate request
basicConstraints 	= CA:FALSE
keyUsage 			= nonRepudiation, digitalSignature, keyEncipherment
subjectAltName 		= @alt_names
[alt_names]
DNS.1 = nebula.sit
DNS.2 = *.nebula.sit
DNS.3 = ops-sit.nebula.sit
DNS.4 = *.ops-sit.nebula.sit
DNS.5 = sc-sit.nebula.sit
DNS.6 = *.sc-sit.nebula.sit
